function createComposites(collection) {
  var nSteps = endDate.difference(startDate, 'day').divide(stepDays).floor();
  var periods = ee.List.sequence(0, nSteps.subtract(1));
  return ee.ImageCollection.fromImages(
    periods.map(function(i) {
      i = ee.Number(i);
      var start = startDate.advance(i.multiply(stepDays), 'day');
      var end = start.advance(stepDays, 'day');
      var subset = collection.filterDate(start, end);
      var composite = subset.median();
      return composite.clip(AOI)
        .set({
          'system:time_start': start.millis(),
          'date': start.format('YYYY-MM-dd'),
          'image_count': subset.size()
        });
    })
  ).filter(ee.Filter.gt('image_count', 0));
}
