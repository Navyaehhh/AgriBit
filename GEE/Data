var ndviHistory = s2Indexed.filterDate(historicalStart, endDate).select('NDVI');
var ndviMin = ndviHistory.min();
var ndviMax = ndviHistory.max();
var vciCollection = anomalyCollection.map(function(img) {
  var vci = img.select('NDVI')
    .subtract(ndviMin)
    .divide(ndviMax.subtract(ndviMin))
    .multiply(100)
    .clamp(0, 100)
    .rename('VCI');
  return img.addBands(vci);
});
