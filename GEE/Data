// Improved Cloud Masking (Scientific Standard)
function maskClouds(img) {
  var scl = img.select('SCL');
  var mask = scl.neq(0)  // No data
    .and(scl.neq(1))    // Saturated/defective
    .and(scl.neq(3))    // Cloud shadows
    .and(scl.neq(8))    // Cloud medium prob
    .and(scl.neq(9))    // Cloud high prob
    .and(scl.neq(10))   // Thin cirrus
    .and(scl.neq(6));   // Water (if focusing on vegetation)
  var qa = img.select('QA60');
  var cloudBit = 1 << 10;
  var cirrusBit = 1 << 11;
  var clearQA = qa.bitwiseAnd(cloudBit).eq(0).and(qa.bitwiseAnd(cirrusBit).eq(0));
  return img.updateMask(mask.and(clearQA))
            .copyProperties(img, ['system:time_start']);
}
