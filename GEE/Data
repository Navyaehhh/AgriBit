function addSAR(img) {
  var filtered = img.focalMedian(20, 'circle', 'meters'); // Improved filter size
  var vv = ee.Image(10).pow(filtered.select('VV').divide(10));
  var vh = ee.Image(10).pow(filtered.select('VH').divide(10));
  var ratio = vv.divide(vh).rename('VV_VH');
  var rvi   = vh.multiply(4).divide(vv.add(vh)).rename('RVI');
  var diff  = filtered.select('VH').subtract(filtered.select('VV')).rename('VH_minus_VV');
  return filtered.addBands([ratio, rvi, diff]).copyProperties(img, ['system:time_start']);
}
