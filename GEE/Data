  var date = ee.Date(opt.get('system:time_start'));
  var sarMatch = s1Anomaly.filterDate(date.advance(-8,'day'), date.advance(5,'day')).mean();
  return opt.addBands(sarMatch.select(['RVI','VV_VH','VV_anomaly','RVI_anomaly']));
});
function joinCollections(col1, col2) {
  var filter = ee.Filter.equals({
    leftField: 'system:time_start',
    rightField: 'system:time_start'
  });
  var joined = ee.Join.inner().apply(col1, col2, filter);
  return ee.ImageCollection(joined.map(function(f) {
      var img1 = ee.Image(f.get('primary'));
      var img2 = ee.Image(f.get('secondary'));
      return img1.addBands(img2).copyProperties(img1, img1.propertyNames());
    })
  );
}
