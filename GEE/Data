function getMetData(start, end) {
  var rain = chirps.filterDate(start, end).sum().clip(AOI).rename('Rain');
  var temp = era5.select('temperature_2m').filterDate(start, end).mean().subtract(273.15).clip(AOI).rename('Temp');
  var soil = era5.select('volumetric_soil_water_layer_1').filterDate(start, end).mean().multiply(100).clip(AOI).rename('SoilMoisture');
  /*var petImg = pet.select('PET').filterDate(start, end).sum().multiply(0.1).clip(AOI).rename('PET');*/
  /*var waterDeficit = rain.subtract(petImg).clip(AOI).rename('WaterDeficit');*/
  return ee.Image.cat([rain, temp, soil]);
}
function createMetCollection() {
  var nSteps = endDate.difference(startDate, 'day').divide(stepDays).floor();
  var periods = ee.List.sequence(0, nSteps.subtract(1));
  return ee.ImageCollection.fromImages(periods.map(function(i){
      i = ee.Number(i);
      var start = startDate.advance(i.multiply(stepDays),'day');
      var end   = start.advance(stepDays,'day');
      return getMetData(start,end)
          .set({
              'system:time_start': start.millis(),
              'date': start.format('YYYY-MM-dd')
          });
    })
  );
}
