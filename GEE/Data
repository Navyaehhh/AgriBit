// 4. VEGETATION INDICES
// =====================================================
function addIndices(img) {
  var s = img.divide(10000);
  var ndvi  = s.normalizedDifference(['B8', 'B4']).rename('NDVI');
  var ndmi  = s.normalizedDifference(['B8', 'B11']).rename('NDMI');
  var ndre  = s.normalizedDifference(['B8', 'B5']).rename('NDRE');
  var gndvi = s.normalizedDifference(['B8', 'B3']).rename('GNDVI');
  var ndwi  = s.normalizedDifference(['B3', 'B8']).rename('NDWI');
  var evi = s.expression('2.5 * ((NIR - RED) / (NIR + 6*RED - 7.5*BLUE + 1))', {
      NIR: s.select('B8'), RED: s.select('B4'), BLUE: s.select('B2')
    }).rename('EVI');
  var msavi = s.expression('0.5 * (2*NIR + 1 - sqrt(pow(2*NIR + 1, 2) - 8*(NIR - RED)))', {
      NIR: s.select('B8'), RED: s.select('B4')
    }).rename('MSAVI');
  return img.addBands([ndvi, ndmi, ndre, gndvi, ndwi, evi, msavi]);
}
